[
  {
    "template_id": "fault_substation_blackout",
    "scene": "fault_plan_generation",
    "name": "变电站全停故障处置模板",
    "description": "适用于35kV、110kV、220kV变电站全停、全所失电、所用电失电、重要用户恢复供电等故障处置任务。",
    "keywords": ["变电站", "全停", "全所失电", "重要用户", "所用电", "恢复供电"],
    "slots": {
      "fault_entity": "变电站名称",
      "voltage_level": "电压等级",
      "fault_type": "全停",
      "important_users": "重要用户列表",
      "dispatch_org": "调度机构"
    },
    "default_entities": [],
    "workflow": [
      {"step": "语义解析故障对象与事故场景", "tool": "slot_filler", "params": {"slots": ["fault_entity", "fault_type", "voltage_level"]}},
      {"step": "召回相似全停预案和历史案例", "tool": "plan_retriever", "params": {"query": "{fault_entity} {fault_type}"}},
      {"step": "统一查询设备图谱、断面和重要用户信息", "tool": "graph_query", "params": {"entities": ["{fault_entity}"]}},
      {"step": "分析失电范围、转供路径和薄弱环节", "tool": "topology_analyzer", "params": {"center_entity": "{fault_entity}"}},
      {"step": "生成候选故障场景并评估恢复风险", "tool": "operator_fault_scenario_generation", "params": {"fault_entity": "{fault_entity}", "fault_type": "{fault_type}"}},
      {"step": "调用稳定计算或在线风险分析算子", "tool": "operator_stability_calculation", "params": {"fault_type": "{fault_type}"}},
      {"step": "检索调规、事故处置依据和编制规则", "tool": "regulation_retriever", "params": {"query": "{fault_entity} {fault_type} 重要用户 汇报"}},
      {"step": "融合风险评估结果和知识规则生成处置策略", "tool": "llm", "params": {"output": "处置策略"}},
      {"step": "生成结构化故障处置预案和人工复核项", "tool": "llm", "params": {"output": "处置预案"}}
    ]
  },
  {
    "template_id": "operation_load_transfer_check",
    "scene": "operation_check",
    "name": "负荷转供操作校核模板",
    "description": "适用于将某变电站或馈线负荷转供至相邻变电站、临时调整运行方式、恢复所用电和重要用户供电的操作校核。",
    "keywords": ["负荷转供", "转供", "恢复所用电", "相邻变电站", "运行方式", "校核"],
    "slots": {
      "source_entity": "原供电设备或变电站",
      "target_entities": "转供来源或目标变电站",
      "operation_type": "负荷转供",
      "protection_actions": "保护投退或定值调整"
    },
    "default_entities": [],
    "workflow": [
      {"step": "语义解析操作行为、设备对象和运行场景", "tool": "slot_filler", "params": {"slots": ["source_entity", "target_entities", "operation_type"]}},
      {"step": "查询源站、目标站和转供相关拓扑", "tool": "graph_query", "params": {"entities": ["{source_entity}", "{target_entities}"]}},
      {"step": "统一查询实时断面、历史库和设备台账", "tool": "source_scanner", "params": {"query": "{source_entity} 转供 断面 设备"}},
      {"step": "分析转供路径、影响用户和薄弱环节", "tool": "topology_analyzer", "params": {"center_entity": "{source_entity}"}},
      {"step": "调用潮流计算算子评估调整后潮流", "tool": "operator_power_flow_calculation", "params": {"area": "{source_entity}", "mode": "{operation_type}"}},
      {"step": "执行越限、N-1和保护配合校核", "tool": "mock_power_check", "params": {"operation_type": "{operation_type}"}},
      {"step": "检索调规、保护投退和操作票约束", "tool": "regulation_retriever", "params": {"query": "{source_entity} 转供 保护 校核"}},
      {"step": "综合机理结果和知识约束生成校核结论", "tool": "llm", "params": {"output": "校核报告"}}
    ]
  },
  {
    "template_id": "operation_protection_check",
    "scene": "operation_check",
    "name": "继电保护投退方案校核模板",
