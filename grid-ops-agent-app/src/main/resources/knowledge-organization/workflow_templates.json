      "contingency_type": "N-1或N-2",
      "fault_entity": "再故障设备"
    },
    "default_entities": [],
    "workflow": [
      {"step": "语义解析检修方式、故障类型和受影响对象", "tool": "slot_filler", "params": {"slots": ["outage_entity", "contingency_type", "fault_entity"]}},
      {"step": "查询停役设备图谱", "tool": "graph_query", "params": {"entities": ["{outage_entity}", "{fault_entity}"]}},
      {"step": "分析剩余拓扑和影响范围", "tool": "topology_analyzer", "params": {"center_entity": "{outage_entity}"}},
      {"step": "生成N-1/N-2候选故障场景", "tool": "operator_fault_scenario_generation", "params": {"outage_entity": "{outage_entity}", "contingency_type": "{contingency_type}"}},
      {"step": "调用潮流和稳定算子进行安全风险评估", "tool": "operator_stability_calculation", "params": {"fault_type": "{contingency_type}"}},
      {"step": "模拟N-1/N-2安全校核", "tool": "mock_power_check", "params": {"operation_type": "{contingency_type}"}},
      {"step": "检索安全校核依据", "tool": "regulation_retriever", "params": {"query": "{contingency_type} 检修 风险 校核"}},
      {"step": "生成风险校核报告", "tool": "llm", "params": {"output": "校核报告"}}
    ]
  },
  {
