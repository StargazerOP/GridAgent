      "duration_or_restore_condition": "持续时间或恢复条件"
    },
    "default_entities": [],
    "workflow": [
      {"step": "语义解析保护调整动作和持续条件", "tool": "slot_filler", "params": {"slots": ["related_entity", "protection_actions", "duration_or_restore_condition"]}},
      {"step": "查询涉及设备、线路和保护对象", "tool": "graph_query", "params": {"entities": ["{related_entity}"]}},
      {"step": "检索继保运行规定和操作约束", "tool": "regulation_retriever", "params": {"query": "{related_entity} 保护 投退 定值"}},
      {"step": "分析保护动作影响范围和风险传播路径", "tool": "operator_spatial_feature_analysis", "params": {"center_entity": "{related_entity}"}},
      {"step": "模拟保护配合、潮流越限和N-1风险", "tool": "mock_power_check", "params": {"operation_type": "保护投退"}},
      {"step": "生成合规校核报告和人工复核项", "tool": "llm", "params": {"output": "校核报告"}}
    ]
  },
  {
    "template_id": "operation_n_minus_one_check",
    "scene": "operation_check",
    "name": "检修方式N-1风险校核模板",
